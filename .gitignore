/target
**/*.rs.bk
node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reproducible-build temp area (see tools/build-env.cmd)
/.tmp/

# Throwaway probes (clones, scratch builds) — evidence is recorded in docs/decisions
/_probe/

# Standalone probe crates keep their own target dirs (~2 GB each)
/tools/*/target/

# Bundled Node runtime (generated by tools/vendor-node.mjs; ~90 MB, never commit)
/runtime/

# Dev distribution archives (tools/package-dev.ps1)
/dist/
